# Optional relay on the SAME VPS as SillyTavern. Never bind this to 0.0.0.0.
# Replace comfy.example.com and the Studio API port before nginx -t.
server {
    listen 127.0.0.1:8189;
    server_name localhost;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host comfy.example.com;
        # For a separate Studio host, use its HTTPS Comfy origin and verify upstream TLS.
        # File content: proxy_set_header Authorization "Bearer YOUR_NATIVE_API_KEY";
        include /etc/nginx/secrets/studio-comfy-auth.conf;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }
}
