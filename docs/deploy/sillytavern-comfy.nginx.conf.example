# Optional relay on the SAME VPS as SillyTavern. Never bind this to 0.0.0.0.
# Replace comfy.example.com and create the secret include before nginx -t.
server {
    listen 127.0.0.1:8189;
    server_name localhost;
    client_max_body_size 0;
    location / {
        proxy_pass https://comfy.example.com;
        proxy_set_header Host comfy.example.com;
        proxy_ssl_server_name on;
        proxy_ssl_name comfy.example.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        # File content: proxy_set_header Authorization "Bearer YOUR_STUDIO_API_TOKEN";
        include /etc/nginx/secrets/studio-comfy-auth.conf;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }
}
