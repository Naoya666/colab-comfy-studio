# Run: uv run python scripts/init_env.py --site-url https://your-own-domain.example
ENVIRONMENT=production
SITE_URL=http://localhost:8788
DATABASE_URL=sqlite:///./data/studio.db
DATA_DIR=./data
STUDIO_PASSWORD=
ENCRYPTION_KEY=
SESSION_SECRET=
STUDIO_API_TOKEN=
GPU_AGENT_TOKEN=
GPU_AGENT_OWNER_ID=owner
GPU_ENABLED=1
GPU_REAL_ENABLED=0
# Trusted executor plugins are administrator-only and disabled by default.
GPU_TRUSTED_EXECUTOR_ENABLED=0
GPU_TRUSTED_EXECUTOR_MODULE=
GPU_TRUSTED_EXECUTOR_ENTRYPOINT=
GPU_TRUSTED_EXECUTOR_VERSION=
GPU_TRUSTED_EXECUTOR_ALLOWLIST=
GPU_TRUSTED_EXECUTOR_CACHE_NAMESPACE=trusted
GPU_STORAGE=local
STUDIO_TIMEZONE=Asia/Shanghai
# Optional initial daily CU limit. The saved CU protection settings take precedence.
GPU_DAILY_UNITS=
# compute units PER MINUTE, administrator estimate, never advertised as actual billing
GPU_UNIT_RATE=
GPU_CREATE_RETRIES=2
GPU_CREATE_TIMEOUT_SECONDS=60
GPU_GOOGLE_CLIENT_ID=
GPU_GOOGLE_CLIENT_SECRET=
GPU_GOOGLE_REDIRECT_URI=
BIND_IP=127.0.0.1
BIND_PORT=8788

# Unified model library: CPU-only transfer worker, no GPU allocation.
# Scratch is temporary and needs free space for one complete model.
# MODEL_LIBRARY_SCRATCH=/data/model-scratch
# MODEL_LIBRARY_MAX_FILE_BYTES=161061273600
# MODEL_LIBRARY_DIRECTORIES={"custom_weights":"custom_weights"}
# MODEL_DEPENDENCY_RULES={"MyReviewedLoader":{"weights_name":"custom_weights"}}
# Configure HF/Civitai credentials in the UI; do not put them in download URLs.

# Creation ComfyUI API (separate host, using Studio jobs; leave empty to disable)
CREATION_COMFY_URL=

# Native ComfyUI (separate public host; leave empty to disable)
NATIVE_COMFY_URL=
# Separate Cloudflare named-tunnel host, protected by Access Service Auth
NATIVE_COMFY_BACKEND_URL=
# Pin an official ComfyUI commit that supports --enable-manager
NATIVE_COMFY_COMMIT=
NATIVE_COMFY_IDLE_MINUTES=120
NATIVE_COMFY_MAX_RUNTIME_MINUTES=720
NATIVE_COMFY_CACHE_GB=20
NATIVE_COMFY_CACHE_MAX_AGE_MINUTES=60
NATIVE_COMFY_MAX_UPLOAD_MB=2048
# JSON: {"client_id":"...","client_secret":"..."}; files mounted read-only
NATIVE_COMFY_ACCESS_FILE=/run/studio-secrets/comfy-access.json
NATIVE_COMFY_TUNNEL_TOKEN_FILE=/run/studio-secrets/comfy-tunnel.token

# Native ComfyUI startup optimizations (Phase 1 & Phase 2; 1=enabled, 0=legacy fallback)
# Phase 1: binary magic scan skip + C pre-filter + parallel scan + 3x scan dedup + scan-cache
NATIVE_FAST_SCAN=1
# Phase 1: batch rclone copy --files-from-raw + parallel pigz/tar archive extraction
NATIVE_PARALLEL_RESTORE=1
# Phase 1: merge base + Manager pip installs and prefer uv with automatic pip fallback
NATIVE_USE_UV=1
# Phase 1: local native readiness report, zero-sleep state advance, async CCU tick, concurrent Access probes
NATIVE_FAST_CONTROL_PLANE=1
# Phase 2: Drive incremental site-packages environment cache (skips pip/nvcc rebuilds on cache hit)
NATIVE_ENV_CACHE=1
# Phase 2: batch enabled plugin requirements.txt + targeted TORCH_CUDA_ARCH_LIST on cold build
NATIVE_BATCH_PLUGIN_PIP=1
# Phase 2: concurrent apt-get, rclone, cloudflared, and ComfyUI checkout initialization
NATIVE_PARALLEL_BOOTSTRAP=1

# Creation Mode startup optimizations (1=enabled, 0=legacy fallback; CREATION_ENV_CACHE=auto|1|0)
# Merge base ComfyUI + huggingface_hub installs via uv with gpu-constraints.txt (falls back to pip)
CREATION_USE_UV=1
# Overlap uv Python deps & custom_nodes checkout with Drive weight & user LoRA downloads
CREATION_PARALLEL_BOOTSTRAP=1
# Opt-in pure-Python multi-stream Range Drive weight downloads (0=default single-stream urllib + single-pass SHA-256/MD5 across 4 parallel files, fastest on Colab->Drive; 1=4-stream big-segment Range >=128 MiB with fallback)
CREATION_MULTI_STREAM_DRIVE=0
# Concurrent continuous Range stream count per large Drive weight when CREATION_MULTI_STREAM_DRIVE=1 (>=128 MiB, 1..8, default 4)
CREATION_DRIVE_STREAMS=4
# Persistent VM-local stamp hash cache for instant local/warm model verification
CREATION_LOCAL_HASH_CACHE=1
# Skip automatic CPU Prep when all workflow weights are already bound in Model Library (Drive)
CREATION_SKIP_DRIVE_PREP=1
# Cache Drive subfolder IDs, concurrent model checks, lean bootstrap, single-WS 4 MiB artifact streaming & fast in-VM polling
CREATION_FAST_CONTROL_PLANE=1
# Drive env-cache policy for Creation Mode (auto=only when custom nodes declare extra deps, 1=force, 0=disabled)
CREATION_ENV_CACHE=auto

# GPU instance keepalive reinforcement & auto-recovery (L0/L1/L2 enabled by default; L3 cross-VM recovery opt-in)
# L0: periodic lightweight TFE keep-alive for active running Colab leases (zero extra GPU cost)
GPU_ACTIVE_KEEPALIVE=1
# L1/L2: in-VM cloudflared/rclone/ComfyUI watchdog self-heal & creation-pool in-place process self-heal
GPU_IN_VM_SELF_HEAL=1
# L3: cross-VM automatic replacement when Colab reclaims a long-lived native or creation(smart/retain) runtime (0=disabled)
GPU_AUTO_RECOVERY_ENABLED=0
# Maximum L3 cross-VM recovery rounds per logical lifecycle (1..10)
GPU_AUTO_RECOVERY_MAX_ROUNDS=3
# Minimum remaining effective lifetime in minutes required before triggering or retrying L3 (>=1)
GPU_AUTO_RECOVERY_MIN_REMAINING_MINUTES=15
# Maximum automatic retries for a single interrupted creation(smart/retain) job (0..3)
GPU_AUTO_RECOVERY_MAX_JOB_RETRIES=1
# Base exponential backoff in seconds for transient NO_RUNTIMES / network failures within a single round (10..300)
GPU_AUTO_RECOVERY_BACKOFF_BASE_SECONDS=30
# Total backoff timeout per L3 recovery round in seconds (60..3600)
GPU_AUTO_RECOVERY_ROUND_TIMEOUT_SECONDS=600
# Watchdog process startup grace window in seconds before triggering L3 (0..300)
GPU_AUTO_RECOVERY_STARTUP_GRACE_SECONDS=30
# Max VPS outage window in minutes before treating missing VM as self-released/maintenance (5..60)
GPU_AUTO_RECOVERY_MAX_VPS_OUTAGE_MINUTES=18
